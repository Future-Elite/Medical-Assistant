# RAG 配置模板（与 server.py 同级）。复制为 .env 后使用；优先级：进程环境变量 > .env > 代码默认。
# 凭据只放 .env 或环境变量，不写代码/文档/git；.env 不进版本控制，本模板随仓库分发。
# live/custom 注册表切换由请求字段 source_mode 决定；来源勾选用 source_kinds。
# 修改后重启服务生效（或调用 reload_config()）。

# ---- 服务 ----
RAG_SERVER_HOST=127.0.0.1
RAG_SERVER_PORT=8798
RAG_REQUEST_TIMEOUT_SECONDS=60.0
RAG_ALLOW_LIVE_PUBMED=true

# ---- 凭据 / 外部服务（留空=未配置；勿提交真实值） ----
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
RAG_NCBI_EMAIL=
RAG_NCBI_API_KEY=
OPENFDA_API_KEY=

# ---- 指南来源与解析（结构性路径留空=用包内默认） ----
# 默认：默认 data/（与 rag/ 同级）（留空=非显式覆盖）
RAG_GUIDELINE_DATA=
# 默认：默认 data/generated/parsing/（留空=非显式覆盖）
RAG_GUIDELINE_WORK=
# 默认：默认 data/guidelines/（留空=非显式覆盖）
RAG_GUIDELINE_PDF_DIR=
RAG_GUIDELINE_CHUNKS=
RAG_MINERU_BIN=
RAG_GUIDELINE_AUTO_PARSE=false
RAG_GUIDELINE_MAX_CHUNKS=3
RAG_GUIDELINE_TOP_K=5
RAG_CUSTOM_SOURCES=

# ---- 演示 ----
RAG_DEMO_PROFILE=neonatal_demo_v1
RAG_DEMO_AUTOLOAD_GUIDELINES=false

# ---- 检索方法 ----
RAG_PUBMED_MAX_RESULTS=200
RAG_RERANKER_MODEL=medcpt
RAG_RERANK_POOL=0
RAG_FIDELITY_LEXICON=
RAG_FIDELITY_POLICY=off
RAG_FIDELITY_PENALTY=0.5
RAG_TERM_MAPPING_LIBRARY=
RAG_ROUTING_MODE=off
RAG_APPLICABILITY_PREVIEW=false

# ---- 实体链接 / MeSH ----
# 默认：默认 rag/demo/mesh_lexicon_neonatal_2026.json（留空=非显式覆盖）
RAG_MESH_LEXICON=
RAG_ENTITY_LINKING_MODE=active
RAG_ENTITY_LINKING_SEMANTIC=true
RAG_ENTITY_LINKING_SURFACES=all
RAG_ENTITY_LINKING_MAX_TOKEN_CANDIDATES=200
RAG_ENTITY_LINKING_MAX_ENTRY_TERMS=2
RAG_ALLOW_MODEL_DOWNLOAD=false

# ---- 主张校验 / 生命周期 ----
RAG_MINICHECK_MODEL=flan-t5-large
RAG_MINICHECK_CACHE_DIR=
RAG_CLAIM_TRANSLATION=true
RAG_GUIDELINE_LIFECYCLE_MODE=active
# 默认：默认 data/generated/guideline_lifecycle_cache.json（留空=非显式覆盖）
RAG_GUIDELINE_LIFECYCLE_CACHE=
RAG_GUIDELINE_LIFECYCLE_TTL_DAYS=7.0

# ---- 患者图谱 ----
RAG_PATIENT_GRAPH_MAX_HOPS=2
RAG_PATIENT_GRAPH_MAX_NODES=240
RAG_PATIENT_GRAPH_LEXICON=
