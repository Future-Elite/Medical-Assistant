  "conditions": [
    {
      "id": "cond:preterm",
      "summary": "胎龄 < 37 周",
      "expr": {
        "lt": [
          {
            "fact": "ga_weeks"
          },
          37
        ]
      }
    },
    {
      "id": "cond:very_preterm",
      "summary": "胎龄 < 32 周",
      "expr": {
        "lt": [
          {
            "fact": "ga_weeks"
          },
          32
        ]
      }
    },
    {
      "id": "cond:term",
      "summary": "胎龄 >= 37 周",
      "expr": {
        "gte": [
          {
            "fact": "ga_weeks"
          },
          37
        ]
      }
    },
    {
      "id": "cond:resp_distress",
      "summary": "存在呼吸窘迫或气促记录",
      "expr": {
        "any": [
          {
            "contains": [
              {
                "fact": "diagnosis"
              },
              "呼吸窘迫"
            ]
          },
          {
            "contains": [
              {
                "fact": "symptom"
              },
              "呼吸窘迫"
            ]
          },
          {
            "contains": [
              {
                "fact": "symptom"
              },
              "气促"
            ]
          }
        ]
      }
    },
    {
      "id": "cond:hypoxemia",
      "summary": "SpO2 <= 90% 或 PaO2 < 50 mmHg",
      "expr": {
        "any": [
          {
            "lte": [
              {
                "fact": "spo2"
              },
              90
            ]
          },
          {
            "lt": [
              {
                "fact": "pao2"
              },
              50
            ]
          }
        ]
      }
    },
    {
      "id": "cond:apnea",
      "summary": "存在呼吸暂停记录",
      "expr": {
        "any": [
          {
            "contains": [
              {
                "fact": "symptom"
              },
              "呼吸暂停"
            ]
          },
          {
            "contains": [
              {
                "fact": "diagnosis"
              },
              "呼吸暂停"
            ]
          }
        ]
      }
    },
    {
      "id": "cond:infection_risk",
      "summary": "GBS 阳性、胎膜早破>=18h 或母亲发热>=38C",
      "expr": {
        "any": [
          {
            "eq": [
              {
                "fact": "gbs_status"
              },
              "positive"
            ]
          },
          {
            "gte": [
              {
                "fact": "prom_hours"
              },
              18
            ]
          },
          {
            "gte": [
              {
                "fact": "maternal_fever_c"
              },
              38
            ]
          }
        ]
      }
    },
    {
      "id": "cond:no_infection_risk",
      "summary": "没有可用的围产感染风险记录",
      "expr": {
        "not": {
          "any": [
            {
              "eq": [
                {
                  "fact": "gbs_status"
                },
                "positive"
              ]
            },
            {
              "gte": [
                {
                  "fact": "prom_hours"
                },
                18
              ]
            },
            {
              "gte": [
                {
                  "fact": "maternal_fever_c"
                },
                38
              ]
            }
          ]
        }
      }
    },
    {
      "id": "cond:clinically_well",
      "summary": "临床评估记录为稳定",
      "expr": {
