EHRWORLD_BASE_URL=
EHRWORLD_MODEL=Qwen3.8-27B
# Requests explicitly disable thinking at gateway and chat-template levels.
EHRWORLD_API_KEY=
EHRWORLD_TIMEOUT=120
EHRWORLD_MAX_TOKENS=4096
EHRWORLD_TEMPERATURE=0
# Set to 1 only if your gateway supports OpenAI JSON mode.
EHRWORLD_JSON_MODE=0
# Full histories are never silently truncated; raise an explicit error above this guard.
EHRWORLD_MAX_INPUT_CHARS=240000
